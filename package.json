{
  "name": "rugby-try",
  "version": "1.0.0",
  "private": true,
  "description": "15s vertical cartoon rugby try animation, drawn entirely in code with Remotion",
  "scripts": {
    "studio": "remotion studio",
    "stills": "node scripts/stills.mjs",
    "render": "remotion render src/index.ts RugbyTry out/rugby-try.mp4 --browser-executable=/opt/pw-browsers/chromium_headless_shell-1194/chrome-linux/headless_shell",
    "render:drop-goal": "remotion render src/index.ts DropGoal out/drop-goal.mp4 --browser-executable=/opt/pw-browsers/chromium_headless_shell-1194/chrome-linux/headless_shell",
    "render:penalty": "remotion render src/index.ts PenaltyKick out/penalty-kick.mp4 --browser-executable=/opt/pw-browsers/chromium_headless_shell-1194/chrome-linux/headless_shell",
    "render:all": "npm run render && npm run render:drop-goal && npm run render:penalty"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.529",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.529"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
